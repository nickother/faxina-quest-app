# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# URL: Project Settings → Data API. Chave: Project Settings → API Keys → Publishable key.
# A publishable key pode ficar no app; nunca use a secret key (sb_secret_...) aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
